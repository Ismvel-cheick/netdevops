#!/usr/sbin/nft -f
# {{ ansible_managed }}
# =============================================================================
# Pare-feu router-fw — environnement : {{ env_name }}
# Politique par défaut : TOUT REFUSER, puis autoriser explicitement les flux
# nécessaires (principe du moindre privilège).
# =============================================================================
flush ruleset

define NET_DMZ  = {{ net_prefix }}.1.0/24
define NET_LAN  = {{ net_prefix }}.2.0/24
define NET_MGMT = {{ net_prefix }}.3.0/24
define NET_ALL  = {{ net_prefix }}.0.0/16
define WEB_DMZ  = {{ net_prefix }}.1.10
define DNS_LAN  = {{ net_prefix }}.2.10

table inet filter {

    # Trafic à destination du routeur lui-même
    chain input {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif lo accept
        ip protocol icmp accept                       # ping (diagnostic)
        ip saddr $NET_MGMT accept                     # administration / supervision
{% if nft_log_drops %}
        limit rate 5/minute log prefix "FW-INPUT-DROP: "
{% endif %}
    }

    # Trafic routé entre les zones
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop

        # Internet + LAN -> serveur web DMZ
        ip daddr $WEB_DMZ tcp dport { {{ nft_web_ports | join(', ') }} } accept

        # DNS du LAN -> résolveurs publics (forwarding dnsmasq)
        ip saddr $DNS_LAN ip daddr != $NET_ALL udp dport 53 accept
        ip saddr $DNS_LAN ip daddr != $NET_ALL tcp dport 53 accept

        # LAN -> Internet
        ip saddr $NET_LAN ip daddr != $NET_ALL tcp dport { {{ nft_lan_internet_ports | join(', ') }} } accept

        # Management -> toutes les zones (supervision, scrape Prometheus)
        ip saddr $NET_MGMT accept

        # Ping depuis LAN/MGMT pour le diagnostic
        ip saddr { $NET_LAN, $NET_MGMT } icmp type echo-request accept

        # Tout le reste est refusé (ex. DMZ -> LAN)
{% if nft_log_drops %}
        limit rate 10/minute log prefix "FW-FORWARD-DROP: "
{% endif %}
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table ip nat {

    # DNAT : les ports web publiés sur le routeur sont redirigés vers web-dmz
    chain prerouting {
        type nat hook prerouting priority -100; policy accept;
        fib daddr type local tcp dport { {{ nft_web_ports | join(', ') }} } dnat to $WEB_DMZ
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        # Les connexions redirigées (DNAT) repartent par le routeur : retour symétrique
        ct status dnat ip daddr $WEB_DMZ masquerade
        # SNAT : sortie vers Internet des zones internes
        ip saddr $NET_ALL ip daddr != $NET_ALL masquerade
    }
}
