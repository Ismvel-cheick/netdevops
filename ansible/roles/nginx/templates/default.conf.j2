# {{ ansible_managed }}
# Nginx — serveur web DMZ (environnement : {{ env_name }})

# Masque la version de Nginx
server_tokens off;

# HTTP -> redirection permanente vers HTTPS
server {
    listen 80;
    server_name {{ nginx_server_name }};
    return 301 https://$host$request_uri;
}

# HTTPS
server {
    listen 443 ssl;
    http2 on;
    server_name {{ nginx_server_name }};

    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       {{ nginx_ssl_protocols }};
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # En-têtes de sécurité
    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    root  /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}

# Statut Nginx pour la supervision, réservé au réseau de management
server {
    listen {{ nginx_status_port }};
    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
        allow {{ net_prefix }}.3.0/24;
        deny all;
    }
}
