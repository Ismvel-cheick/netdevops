# {{ ansible_managed }}
# =============================================================================
# NetDevOps — environnement : {{ env_name }}
#   {{ name_prefix }}dmz-net  {{ net_prefix }}.1.0/24 : web-dmz
#   {{ name_prefix }}lan-net  {{ net_prefix }}.2.0/24 : dns-lan, client1, client2 (internal)
#   {{ name_prefix }}mgmt-net {{ net_prefix }}.3.0/24 : supervision
# Les fichiers de configuration (nftables, dnsmasq, nginx) sont générés par Ansible
# dans ce dossier et montés en lecture seule dans les conteneurs.
# =============================================================================

services:

  router-fw:
    build: {{ repo_dir }}/docker/router-fw
    image: netdevops/router-fw:{{ image_tag }}
    container_name: {{ name_prefix }}router-fw
    hostname: router-fw
    cap_add: [NET_ADMIN, NET_RAW]
    sysctls:
      net.ipv4.ip_forward: 1
      net.ipv4.conf.all.rp_filter: 0
    environment:
      NFT_CONF: /etc/nft/nftables.conf
    volumes:
      - ./router-fw:/etc/nft:ro
    ports:
      - "{{ http_port }}:80"
      - "{{ https_port }}:443"
    networks:
      dmz-net:
        ipv4_address: {{ net_prefix }}.1.1
        gw_priority: 100
      lan-net:
        ipv4_address: {{ net_prefix }}.2.1
      mgmt-net:
        ipv4_address: {{ net_prefix }}.3.1
    restart: unless-stopped

  web-dmz:
    build: {{ repo_dir }}/docker/web-dmz
    image: netdevops/web-dmz:{{ image_tag }}
    container_name: {{ name_prefix }}web-dmz
    hostname: web-dmz
    cap_add: [NET_ADMIN]
    environment:
      GATEWAY: {{ net_prefix }}.1.1
    volumes:
      - ./web-dmz:/etc/nginx/conf.d:ro
    networks:
      dmz-net:
        ipv4_address: {{ net_prefix }}.1.10
    depends_on: [router-fw]
    restart: unless-stopped

  dns-lan:
    build: {{ repo_dir }}/docker/dns-lan
    image: netdevops/dns-lan:{{ image_tag }}
    container_name: {{ name_prefix }}dns-lan
    hostname: dns-lan
    cap_add: [NET_ADMIN]
    environment:
      GATEWAY: {{ net_prefix }}.2.1
      DNSMASQ_CONF: /etc/dnsmasq.d/dnsmasq.conf
    volumes:
      - ./dns-lan:/etc/dnsmasq.d:ro
    networks:
      lan-net:
        ipv4_address: {{ net_prefix }}.2.10
    depends_on: [router-fw]
    restart: unless-stopped

{% for client in [{'name': 'client1', 'ip': '2.100'}, {'name': 'client2', 'ip': '2.101'}] %}
  {{ client.name }}:
{% if loop.first %}
    build: {{ repo_dir }}/docker/client
{% else %}
    pull_policy: never
{% endif %}
    image: netdevops/client:{{ image_tag }}
    container_name: {{ name_prefix }}{{ client.name }}
    hostname: {{ client.name }}
    cap_add: [NET_ADMIN, NET_RAW]
    environment:
      GATEWAY: {{ net_prefix }}.2.1
    dns: [{{ net_prefix }}.2.10]
    networks:
      lan-net:
        ipv4_address: {{ net_prefix }}.{{ client.ip }}
    depends_on: [router-fw, dns-lan{{ '' if loop.first else ', client1' }}]
    restart: unless-stopped

{% endfor %}
  # ---------------------------------------------------------------------------
  # Supervision (réseau MGMT). "monitoring" porte l'adresse {{ net_prefix }}.3.10 ;
  # Prometheus, Grafana et les exporters partagent son interface réseau.
  # Il route uniquement les zones DMZ et LAN via le pare-feu.
  # ---------------------------------------------------------------------------
  monitoring:
    image: alpine:3.20
    container_name: {{ name_prefix }}monitoring
    hostname: monitoring
    cap_add: [NET_ADMIN]
    command:
      - sh
      - -c
      - >-
        ip route replace {{ net_prefix }}.1.0/24 via {{ net_prefix }}.3.1 &&
        ip route replace {{ net_prefix }}.2.0/24 via {{ net_prefix }}.3.1 &&
        exec sleep infinity
    ports:
      - "{{ prometheus_port }}:9090"
      - "{{ grafana_port }}:3000"
    networks:
      mgmt-net:
        ipv4_address: {{ net_prefix }}.3.10
    depends_on: [router-fw]
    restart: unless-stopped

  prometheus:
    image: {{ prometheus_image }}
    container_name: {{ name_prefix }}prometheus
    network_mode: "service:monitoring"
    command:
      - --config.file=/etc/prometheus-cfg/prometheus.yml
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      - --web.enable-lifecycle
    volumes:
      - ./monitoring/prometheus:/etc/prometheus-cfg:ro
      - prometheus-data:/prometheus
    depends_on: [monitoring]
    restart: unless-stopped

  node-exporter:
    image: {{ node_exporter_image }}
    container_name: {{ name_prefix }}node-exporter
    network_mode: "service:monitoring"
    pid: host
    command:
      - --path.procfs=/host/proc
      - --path.sysfs=/host/sys
      - --path.rootfs=/rootfs
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    depends_on: [monitoring]
    restart: unless-stopped

  nginx-exporter:
    image: {{ nginx_exporter_image }}
    container_name: {{ name_prefix }}nginx-exporter
    network_mode: "service:monitoring"
    command:
      - --nginx.scrape-uri=http://{{ net_prefix }}.1.10:8080/nginx_status
    depends_on: [monitoring, web-dmz]
    restart: unless-stopped

  blackbox:
    image: {{ blackbox_image }}
    container_name: {{ name_prefix }}blackbox
    network_mode: "service:monitoring"
    command:
      - --config.file=/etc/blackbox/blackbox.yml
    volumes:
      - ./monitoring/blackbox:/etc/blackbox:ro
    depends_on: [monitoring]
    restart: unless-stopped

  grafana:
    image: {{ grafana_image }}
    container_name: {{ name_prefix }}grafana
    network_mode: "service:monitoring"
    environment:
      GF_SECURITY_ADMIN_USER: {{ grafana_admin_user }}
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH: /var/lib/grafana/dashboards/netdevops.json
    volumes:
      - ./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
      - ./monitoring/grafana/admin_password:/run/secrets/grafana_admin_password:ro
      - grafana-data:/var/lib/grafana
    depends_on: [monitoring, prometheus]
    restart: unless-stopped

volumes:
  prometheus-data:
  grafana-data:

networks:
  dmz-net:
    name: {{ name_prefix }}dmz-net
    driver: bridge
    ipam:
      config:
        - subnet: {{ net_prefix }}.1.0/24
          gateway: {{ net_prefix }}.1.254
  lan-net:
    name: {{ name_prefix }}lan-net
    driver: bridge
    internal: true
    ipam:
      config:
        - subnet: {{ net_prefix }}.2.0/24
          gateway: {{ net_prefix }}.2.254
  mgmt-net:
    name: {{ name_prefix }}mgmt-net
    driver: bridge
    ipam:
      config:
        - subnet: {{ net_prefix }}.3.0/24
          gateway: {{ net_prefix }}.3.254
